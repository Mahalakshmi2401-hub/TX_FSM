`timescale 1ns/1ps

module tx_fsm_top #(
    parameter SPEED_GRADE = 1
)(
    input  wire clk,
    input  wire rst_n,

    input  wire startup_req,
    input  wire phy_block_valid,

    input  wire startup_done,
    input  wire hdr_done,
    input  wire fec_done,
    input  wire scramble_done,
    input  wire map_done,
    input  wire tx_done,

    output reg startup_en,
    output reg hdr_en,
    output reg fec_en,
    output reg scramble_en,
    output reg map_en,
    output reg tx_en,
    output wire [2:0] current_debug_state,
    output wire [2:0] next_debug_state
);

    localparam [2:0] ST_IDLE     = 3'd0;
    localparam [2:0] ST_STARTUP  = 3'd1;
    localparam [2:0] ST_HEADER   = 3'd2;
    localparam [2:0] ST_FEC      = 3'd3;
    localparam [2:0] ST_SCRAMBLE = 3'd4;
    localparam [2:0] ST_MAP      = 3'd5;
    localparam [2:0] ST_TX       = 3'd6;

    reg [2:0] current_state;
    reg [2:0] next_state;

    assign current_debug_state = current_state;
    assign next_debug_state    = next_state;
    
    always @(posedge clk or negedge rst_n) begin
     if (!rst_n)
      current_state <= ST_IDLE;
     else
      current_state <= next_state;
    end

    always @(*) begin
     next_state = current_state;
     case(current_state)
      ST_IDLE: begin
       if(startup_req && phy_block_valid)
        next_state = ST_STARTUP;
       else
        next_state = ST_IDLE;
      end

      ST_STARTUP: begin
       if(startup_done)
        next_state = ST_HEADER;
       else
        next_state = ST_STARTUP;
      end

      ST_HEADER: begin
       if(hdr_done)
        next_state = ST_FEC;
       else
        next_state = ST_HEADER;
      end

      ST_FEC: begin
       if(fec_done)
        next_state = ST_SCRAMBLE;
       else
        next_state = ST_FEC;
      end

      ST_SCRAMBLE: begin
       if(scramble_done)
        next_state = ST_MAP;
       else
        next_state = ST_SCRAMBLE;
      end

      ST_MAP: begin
       if(map_done)
        next_state = ST_TX;
       else
        next_state = ST_MAP;
      end

      ST_TX: begin
       if(tx_done)
        next_state = ST_IDLE;
       else
        next_state = ST_TX;
      end
      
      default: begin
       next_state = ST_IDLE;
      end
     endcase
    end

    always @(*) begin
     startup_en  = 1'b0;
     hdr_en      = 1'b0;
     fec_en      = 1'b0;
     scramble_en = 1'b0;
     map_en      = 1'b0;
     tx_en       = 1'b0;
     case (current_state)
      ST_IDLE: begin
       startup_en  = 1'b0;
       hdr_en      = 1'b0;
       fec_en      = 1'b0;
       scramble_en = 1'b0;
       map_en      = 1'b0;
       tx_en       = 1'b0;
      end

      ST_STARTUP: begin
       startup_en = 1'b1;
      end

      ST_HEADER: begin
       hdr_en = 1'b1;
      end

      ST_FEC: begin
       fec_en = 1'b1;
      end

      ST_SCRAMBLE: begin
       scramble_en = 1'b1;
      end

      ST_MAP: begin
       map_en = 1'b1;
      end

      ST_TX: begin
       tx_en = 1'b1;
      end

      default: begin
       startup_en  = 1'b0;
       hdr_en      = 1'b0;
       fec_en      = 1'b0;
       scramble_en = 1'b0;
       map_en      = 1'b0;
       tx_en       = 1'b0;
       end
     endcase
    end
endmodule
